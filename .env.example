# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Only these emails may use the AI and calendar routes (comma-separated)
ALLOWED_EMAIL=you@example.com
# console.anthropic.com → API keys (server only, never NEXT_PUBLIC)
ANTHROPIC_API_KEY=
# Google Calendar → Settings → your calendar → "Secret address in iCal format"
GCAL_ICS_URL=
# Phone reminders (server only). Generate the two VAPID keys with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Supabase project settings → API → service_role key. Lets the reminder job read tasks. Never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. The Supabase reminder job sends it; it also signs notification and alarm links.
CRON_SECRET=
